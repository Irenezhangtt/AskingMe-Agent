# AskingMe Agent environment variable example
# Copy this file to .env and fill in the actual values

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AskingMe Agent
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional model split: use a faster model for routing/retrieval and keep the
# strongest model for the employee-facing answer.
ANSWER_MODEL=claude-sonnet-4-6
ROUTER_MODEL=claude-sonnet-4-6
RETRIEVAL_MODEL=claude-sonnet-4-6
ANSWER_MAX_TOKENS=650

# Optional: set only when using a third-party service compatible with the Anthropic protocol
# ANTHROPIC_BASE_URL=https://your-compatible-provider.example/v1

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=replace_with_a_long_random_password
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600
POLICY_KB_VERSION=demo-v2

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
RAG_REWRITE_MODE=adaptive
RAG_RERANK_MODE=adaptive
RAG_MIN_DIRECT_SCORE=0.25
RAG_MIN_DIRECT_MARGIN=0.03
RAG_RERANK_MIN_MARGIN=0.025
RAG_WARMUP_ENABLED=true

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── Evaluation ────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# Reads ./skills by default and supports runtime reload through POST /skills/reload
ASKINGME_SKILLS_DIR=./skills
ASKINGME_SKILLS_MAX_PROMPT_CHARS=5000

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production
ADMIN_API_KEY=replace_with_a_64_character_random_hex_value
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Admin-Key
DEMO_QUOTA_ENABLED=true
DEMO_DAILY_GLOBAL_LIMIT=50
DEMO_DAILY_IP_LIMIT=5

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
INTENT_EXTRACT_ENTITIES=false
STREAM_CHUNK_CHARS=48

# Policy Calculator screenshots require a vision-capable ANSWER_MODEL.
# Uploaded evidence is request-scoped and requires ADMIN_API_KEY; it is not indexed.

# ── Pricing RAG ───────────────────────────────────────────────────────────────
# elasticsearch is the default; chroma retains the previous enterprise Q&A path.
RAG_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=askingme-pricing-en-v1
# ELASTICSEARCH_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
RAG_DEVICE=cpu
RAG_CHUNK_TOKENS=400
RAG_CANDIDATE_K=50
RAG_CONTEXT_TOKENS=2400
RAG_MIN_RERANK_SCORE=0.35
RAG_MAX_REWRITES=1
RAG_LOAD_EXAMPLES=true
