# AskingMe Agent enterprise policy Q&A system - environment variable example
# Copy this file to .env and fill in the actual configuration values

# ============================================
# Application settings
# ============================================
APP_NAME=AskingMe Agent
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ============================================
# API service settings
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4
MAX_CONNECTIONS=1000
REQUEST_TIMEOUT=30

# ============================================
# Anthropic Claude API settings
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# ============================================
# Redis cache settings
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=replace_with_a_long_random_password
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# ============================================
# ChromaDB vector database settings
# ============================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_AUTH_TOKEN=askingme-token-123
CHROMA_COLLECTION_NAME=askingme_memories

# ============================================
# Intent recognition settings
# ============================================
INTENT_MODEL=sentence-transformers/all-MiniLM-L6-v2
INTENT_CONFIDENCE_THRESHOLD=0.6
INTENT_CACHE_SIZE=1000
INTENT_CACHE_TTL=3600

# ============================================
# Agent orchestration settings
# ============================================
AGENT_TIMEOUT=30
AGENT_MAX_PARALLEL=3
AGENT_RATE_LIMIT=100
AGENT_PRIORITY_ENABLED=true

# ============================================
# Tool invocation settings
# ============================================
TOOL_TIMEOUT=30
TOOL_RATE_LIMIT=100
TOOL_CACHE_ENABLED=true
TOOL_CACHE_TTL=300
TOOL_CIRCUIT_BREAKER_THRESHOLD=5
TOOL_CIRCUIT_BREAKER_TIMEOUT=60

# ============================================
# Memory management settings
# ============================================
MEMORY_MAX_WORKING=50
MEMORY_MAX_TOKENS=8000
MEMORY_COMPRESSION_THRESHOLD=10
MEMORY_COMPRESSION_RATIO=0.3
MEMORY_TTL_HOURS=720

# ============================================
# Monitoring settings
# ============================================
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
ALERT_WEBHOOK_URL=
MONITORING_INTERVAL=5
ANOMALY_DETECTION_THRESHOLD=2.0

# ============================================
# Evaluation settings
# ============================================
EVALUATION_ENABLED=true
EVALUATION_INTERVAL=3600
QUALITY_ASSESSMENT_ENABLED=true
REGRESSION_TEST_ENABLED=true

# ============================================
# Enterprise policy skills
# ============================================
ASKINGME_SKILLS_DIR=./skills
ASKINGME_SKILLS_MAX_PROMPT_CHARS=5000

# ============================================
# Security settings
# ============================================
SECRET_KEY=your_secret_key_here_change_this_in_production
JWT_SECRET_KEY=your_jwt_secret_key_here
ADMIN_API_KEY=replace_with_a_64_character_random_hex_value
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# CORS settings
# ============================================
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization
DEMO_QUOTA_ENABLED=true
DEMO_DAILY_GLOBAL_LIMIT=50
DEMO_DAILY_IP_LIMIT=5

# ============================================
# Logging settings
# ============================================
LOG_FILE=./logs/askingme.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================
# Database settings (optional)
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/askingme
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT=30

# ============================================
# External service settings (optional)
# ============================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# PAGERDUTY_API_KEY=your_pagerduty_api_key
# SENTRY_DSN=your_sentry_dsn

# ============================================
# Feature flags
# ============================================
ENABLE_TELEMETRY=false
ENABLE_ANALYTICS=false
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_SWAGGER_UI=true
